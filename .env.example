# Copiar a .env (local) o cargar en el panel "Environment" de Render. Nunca subir .env a git.

PORT=3000
NODE_ENV=development

# Secreto para firmar la cookie de sesión (en producción: cadena larga aleatoria)
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Google Analytics 4: ID de medición del flujo web (G-XXXXXXXXXX)
GA_MEASUREMENT_ID=
# true = los eventos aparecen en GA4 > Administrar > DebugView
GA_DEBUG=false

# Base de datos. Local: archivo SQLite. Nube: Turso (libsql://<bd>-<usuario>.turso.io + token)
DATABASE_URL=file:data/tienda.db
DATABASE_AUTH_TOKEN=

# Webpay Plus: vacío = credenciales públicas de INTEGRACIÓN de Transbank (sandbox)
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
# URL pública del sitio (opcional; si está vacía se deduce de la petición)
BASE_URL=

# Permite el medio de pago "simulado" (lo usan los generadores de carga)
PAGO_SIMULADO_HABILITADO=true

# Costo de bcrypt (10 = estándar; impacta CPU en login/registro)
BCRYPT_ROUNDS=10

# Crea usuarios carga01..carga50@test.local (clave Carga123!) para k6
SEMBRAR_USUARIOS_CARGA=true

# Si se define, /api/metricas exige el header x-metricas-token o ?token=
METRICAS_TOKEN=

# Cookie solo por HTTPS (por defecto true si NODE_ENV=production)
# COOKIE_SEGURA=true
